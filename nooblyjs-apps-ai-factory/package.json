{
  "name": "nooblyjs-ai",
  "version": "0.1.0",
  "description": "NooblyJS AI, an engineering-lifecycle platform (idea → spec → architecture → design → build → ship, where AI agents draft and people decide): the host and its apps (Product, Design, the Software Factory, Infrastructure, Security, Operations, Teammates, Knowledge) as one solution.",
  "homepage": "https://github.com/StephenBooysen/nooblyjs-apps#readme",
  "bugs": {
    "url": "https://github.com/StephenBooysen/nooblyjs-apps/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenBooysen/nooblyjs-apps.git",
    "directory": "nooblyjs-apps-ai-factory"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app.js",
    "dev": "nodemon --watch src --watch test app.js",
    "run": "npm start",
    "electron": "electron apps/electron/main.js",
    "test:electron": "electron apps/electron/main.js --smoke",
    "test:edge": "node apps/edge/scripts/smoke.mjs",
    "test": "npm run test:host && npm run test:apps",
    "pretest:host": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "test:host": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/unit.txt --test-force-exit \"test/**/*.test.js\"",
    "pretest:apps": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "test:apps": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/apps.txt --test-force-exit --test-timeout=120000 \"src/apps/*/test/**/*.test.js\" \"src/apps/factory/quality/test/**/*.test.js\" \"src/apps/knowledge/test/**/*.test.mjs\"",
    "test:knowledge:jest": "jest -c src/apps/knowledge/jest.config.cjs",
    "precoverage": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "coverage": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/coverage.txt --test-force-exit --experimental-test-coverage \"test/**/*.test.js\" \"src/apps/*/test/**/*.test.js\" \"src/apps/factory/quality/test/**/*.test.js\" \"src/apps/knowledge/test/**/*.test.mjs\"",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:blank": "node --env-file-if-exists=.env scripts/seed.js --blank",
    "seed:clear": "node --env-file-if-exists=.env scripts/seed.js --blank --delete",
    "metrics:reconcile": "node --env-file-if-exists=.env scripts/metrics-reconcile.js",
    "trace:rebuild": "node --env-file-if-exists=.env scripts/trace-rebuild.js",
    "steering:sync": "node scripts/sync-steering.js",
    "docs:okf": "node scripts/okf.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "perf": "node scripts/perf.js",
    "port:ui": "node src/apps/knowledge/scripts/port-wiki-ui.mjs",
    "factory": "node src/apps/factory/bin/factory.js",
    "check:examples": "src/apps/factory/scripts/check-examples.sh",
    "pretest:live": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "test:live": "node --env-file-if-exists=.env --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/live.txt test/live/chat.live.js test/live/cloud.live.js",
    "pretest:live:devtools": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "test:live:devtools": "node --env-file-if-exists=.env --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/live-devtools.txt test/live/devtools.live.js",
    "pretest:live:product": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "test:live:product": "node --env-file-if-exists=.env --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/live-product.txt test/live/product-drafts.live.js",
    "pretest:live:factory": "node -e \"process.getBuiltinModule('fs').mkdirSync('.temp/test-results',{recursive:true})\"",
    "test:live:factory": "node --env-file-if-exists=.env --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.temp/test-results/live-factory.txt test/live/factory.live.js",
    "test:live:teammate": "node --env-file-if-exists=.env src/apps/teammate/scripts/live-smoke.js",
    "test:e2e": "playwright test -c test/e2e/playwright.config.js && playwright test -c test/e2e/playwright.story.config.js && playwright test -c test/e2e/playwright.factory.config.js && playwright test -c test/e2e/playwright.knowledge.config.js && playwright test -c test/e2e/playwright.platform.config.js && playwright test -c test/e2e/playwright.infrastructure.config.js && playwright test -c test/e2e/playwright.customers.config.js",
    "start:desktop": "npm start --prefix ../nooblyjs-apps-ai-desktop",
    "start:harness": "npm start --prefix ../nooblyjs-apps-ai-harness"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@anthropic-ai/sdk": "^0.71.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "chokidar": "^4.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "express4": "npm:express@^4.22.3",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^17.11.0",
    "js-yaml": "^4.3.2",
    "mammoth": "^1.11.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.0-rc.4",
    "nooblyjs-ai-harness": "file:../nooblyjs-apps-ai-harness",
    "nooblyjs-core": "file:../../nooblyjs-core",
    "openai": "^6.16.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^5.0.0",
    "pptx-parser": "^1.1.7-beta.9",
    "pptx2json": "^0.0.10",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "validator": "^13.11.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@highlightjs/cdn-assets": "11.12.0",
    "@playwright/test": "1.63.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "codemirror": "5.65.21",
    "electron": "^44.7.0",
    "jest": "^30.2.0",
    "marked": "4.3.0",
    "mermaid": "10.9.8",
    "nodemon": "^3.1.14",
    "prismjs": "1.30.0",
    "supertest": "^7.2.2"
  }
}
